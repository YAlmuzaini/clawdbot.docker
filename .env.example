# OpenClaw Gateway Configuration
# Copy this file to .env and configure your values
#
# Quick Start:
# 1. cp .env.example .env
# 2. Generate token: openssl rand -hex 32
# 3. Paste the token below
# 4. docker compose up -d openclaw-gateway
# 5. Access: http://localhost:18789

# ============================================
# REQUIRED: Gateway Token
# ============================================
# Generate a secure token with:
#   openssl rand -hex 32
# 
# Or in Python:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Coolify Note: When deploying to Coolify, these are auto-generated:
#   - SERVICE_PASSWORD_OPENCLAW (auto-generated secure token)
#   - SERVICE_URL_OPENCLAW_18789 (your domain URL)
#   - SERVICE_FQDN_OPENCLAW (your domain FQDN)
#   - OPENCLAW_GATEWAY_TOKEN (will show in UI, defaults to SERVICE_PASSWORD_OPENCLAW)
# 
# In Coolify: Leave OPENCLAW_GATEWAY_TOKEN empty to use the auto-generated password,
# or set a custom value if needed.
OPENCLAW_GATEWAY_TOKEN=

# ============================================
# Gateway Network Configuration
# ============================================
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789

# ============================================
# Storage Paths
# ============================================
# These paths will be created automatically if they don't exist
# For production VPS: use absolute paths like /opt/openclaw/config
# For Coolify: these are managed automatically
OPENCLAW_CONFIG_DIR=./openclaw-config
OPENCLAW_WORKSPACE_DIR=./openclaw-workspace

# ============================================
# Model Provider API Keys (Optional)
# ============================================
# Configure these in OpenClaw UI after first login
# or set them here for convenience

# OpenAI
#OPENAI_API_KEY=sk-...

# Anthropic Claude
#ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
#GOOGLE_AI_API_KEY=...

# ============================================
# Channel Configuration (Optional)
# ============================================
# Configure channels via CLI after gateway is running:
#
# WhatsApp (QR code):
#   docker compose run --rm openclaw-cli channels login
#
# Telegram (bot token from @BotFather):
#   docker compose run --rm openclaw-cli channels add --channel telegram --token <YOUR_BOT_TOKEN>
#
# Discord (bot token from Discord Developer Portal):
#   docker compose run --rm openclaw-cli channels add --channel discord --token <YOUR_BOT_TOKEN>
#
# Docs: https://docs.openclaw.ai/channels

# ============================================
# Advanced Configuration (Optional)
# ============================================
# Usually not needed - defaults are fine
#NODE_ENV=production
#TERM=xterm-256color
