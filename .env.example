# OpenClaw Gateway Configuration
# Copy this file to .env and configure your values

# Gateway Token (REQUIRED)
# Generate a secure token with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-secure-random-token

# Gateway Network Configuration
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789

# Storage Paths
# These paths will be created automatically if they don't exist
OPENCLAW_CONFIG_DIR=./openclaw-config
OPENCLAW_WORKSPACE_DIR=./openclaw-workspace

# Optional: Model Provider API Keys
# Uncomment and set the providers you want to use

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_AI_API_KEY=...

# Optional: Channel Configuration
# These are configured via CLI after initial setup
# WhatsApp: docker compose run --rm openclaw-cli channels login
# Telegram: docker compose run --rm openclaw-cli channels add --channel telegram --token <bot_token>
# Discord: docker compose run --rm openclaw-cli channels add --channel discord --token <bot_token>

# Optional: Advanced Configuration
# NODE_ENV=production
# TERM=xterm-256color
