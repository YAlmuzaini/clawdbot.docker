# Clawdbot Gateway Configuration
# Copy this file to .env and fill in your values

# Docker image name
# Use a pre-built image from Docker Hub (recommended):
#   CLAWDBOT_IMAGE=almuzaini/clawdbot:latest
# Or build from source by uncommenting build: in docker-compose.yml
CLAWDBOT_IMAGE=almuzaini/clawdbot:latest

# Gateway Token (REQUIRED)
# Generate a strong token: openssl rand -hex 32
CLAWDBOT_GATEWAY_TOKEN=change-me-now

# Gateway bind address (default: lan)
# Options: lan, localhost, 0.0.0.0
CLAWDBOT_GATEWAY_BIND=lan

# Gateway port (default: 18789)
CLAWDBOT_GATEWAY_PORT=18789

# Persistent storage directories (relative to compose file or absolute paths)
# These directories will be created automatically by Coolify if using is_directory: true
CLAWDBOT_CONFIG_DIR=./data/.clawdbot
CLAWDBOT_WORKSPACE_DIR=./data/clawd

# Gmail OAuth keyring password (REQUIRED if using Gmail)
# Generate a strong password: openssl rand -hex 32
GOG_KEYRING_PASSWORD=change-me-now

# XDG config home (default: /home/node/.clawdbot)
XDG_CONFIG_HOME=/home/node/.clawdbot

# Optional: Extra apt packages to install during build
# Space-separated list of package names
# CLAWDBOT_DOCKER_APT_PACKAGES=ffmpeg build-essential

# Optional: Extra mounts (comma-separated list of Docker bind mounts)
# Format: host_path:container_path:mode
# Example: /host/path:/container/path:ro
# CLAWDBOT_EXTRA_MOUNTS=

# Optional: Named volume for /home/node persistence
# Use a named volume instead of bind mount for the entire home directory
# CLAWDBOT_HOME_VOLUME=clawdbot_home

# Coolify Magic Environment Variables (automatically generated)
# You can use these in your compose file:
# - SERVICE_URL_CLAWDBOT_GATEWAY (generates URL for the gateway service)
# - SERVICE_FQDN_CLAWDBOT_GATEWAY (generates FQDN for the gateway service)
# - SERVICE_PASSWORD_CLAWDBOT_GATEWAY (generates random password)
# - SERVICE_USER_CLAWDBOT_GATEWAY (generates random username)
